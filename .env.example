GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173
VITE_ELECTRICITY_RATE=2

# === FREE-BY-DEFAULT ===
# Solar-unified runs zero-cost out of the box: Nominatim geocoding, ArcGIS
# satellite imagery, Ollama vision (Moondream) for panel detection. No paid
# API key is required. The flags below stay at 0 unless you explicitly want
# to pay for Gemini / Google Solar API precision.

# Paid-API safety gates (default OFF to avoid surprise billing).
# Google Solar API is ALWAYS paid per call (~$0.01-$0.04 each).
# Gemini AI Studio keys are free tier; Google Cloud Gemini keys may bill.
# Flip to 1 explicitly when you want to pay for higher precision.
ALLOW_GOOGLE_SOLAR_API=0
ALLOW_EXTERNAL_LLM=0

# LLM-routing — default "ollama" (free, local). Set to "gemini" only with
# ALLOW_EXTERNAL_LLM=1 + GEMINI_API_KEY set.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_TEXT_MODEL=qwen2.5:1.5b

# Detection-pipeline backend selection:
#   auto (default)  → ml > embed > moondream > gemini (first available wins)
#   moondream       → force local Ollama vision (free)
#   embed           → trained mobilenet head (free, needs head.npz)
#   ml              → YOLOv8-seg ONNX (free, needs onnx file)
#   gemini          → paid Gemini Vision (kräver ALLOW_EXTERNAL_LLM=1)
#   gemini-legacy   → bypass dispatcher entirely (call gemini.generate_json
#                     directly — for back-compat with pre-dispatcher scripts)
DETECTION_BACKEND=auto
